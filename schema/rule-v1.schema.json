{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsp3cesarschool.github.io/5ltep-layer2/schema/rule-v1.schema.json",
  "title": "5L-TEP Layer 2 rule, format 1.0",
  "description": "One check per file in rules/ (any subfolder). `description` is for people; `sources` and `check` are for the engine. Every source is a CKAN resource. One schema for every rule. `python main.py validate` also checks that each source.column used by `check` is declared in `sources`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "origin", "description", "sources", "check"],
  "properties": {
    "schema_version": {"const": "1.0", "description": "Version of this format."},
    "id": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)+$",
      "description": "Stable identifier with at least one dot, e.g. territory.municipality-state. The file is named <id>.yaml."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Version of the rule (MAJOR.MINOR.PATCH), quoted."
    },
    "origin": {
      "enum": ["expert", "cross_reference", "ai"],
      "description": "Who proposed the check. It does not prove validity."
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "title", "text", "justification", "examples"],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?$",
          "description": "BCP 47 tag of the texts, e.g. pt-BR, en, es."
        },
        "title": {"$ref": "#/$defs/text", "maxLength": 200},
        "text": {"$ref": "#/$defs/text"},
        "justification": {"$ref": "#/$defs/text"},
        "exceptions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "expected"],
            "properties": {"case": {"$ref": "#/$defs/text"}, "expected": {"$ref": "#/$defs/text"}}
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "check": {
      "type": "object",
      "required": ["template"],
      "properties": {"template": {"enum": ["lookup-equals"]}},
      "allOf": [
        {"if": {"properties": {"template": {"const": "lookup-equals"}}}, "then": {"$ref": "#/$defs/lookup_equals"}}
      ]
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "column_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}\\..+$",
      "description": "source.column, e.g. ibama_autos.COD_MUNICIPIO. The column name is copied exactly."
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/column_ref"}, "to": {"$ref": "#/$defs/column_ref"}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portal", "dataset", "resource", "file", "columns"],
      "properties": {
        "portal": {"type": "string", "pattern": "^https://[^/\\s]+(/[^\\s]*)?$", "description": "Address of the CKAN portal."},
        "dataset": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$", "description": "Exact CKAN name or id of the dataset."},
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "format"],
          "properties": {
            "name": {"$ref": "#/$defs/text", "description": "Exact resource name in CKAN."},
            "format": {"$ref": "#/$defs/text", "description": "Format declared in CKAN, e.g. CSV."}
          }
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "members"],
          "properties": {
            "type": {"enum": ["zip"]},
            "members": {
              "type": "string",
              "pattern": "^[^\\s/\\\\][^/\\\\]*(/[^/\\\\]+)*$",
              "description": "File inside the archive, or a pattern with * and ? for several files (stacked)."
            }
          }
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "encoding", "delimiter"],
          "properties": {
            "format": {"enum": ["csv"]},
            "encoding": {"enum": ["utf-8", "latin-1", "cp1252"]},
            "delimiter": {"enum": [";", ",", "\t", "|"]}
          }
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/text"},
          "description": "column: meaning. Only declared columns are read."
        }
      }
    },
    "lookup_equals": {
      "description": "For each record of the `from` source, find the key in the `to` source and compare one value.",
      "required": ["template", "key", "compare"],
      "properties": {
        "template": {"const": "lookup-equals"},
        "key": {"$ref": "#/$defs/pair"},
        "compare": {"$ref": "#/$defs/pair"}
      },
      "additionalProperties": false
    }
  }
}
